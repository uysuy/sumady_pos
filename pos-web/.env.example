# ── Runtime (PM2 / adapter-node) ─────────────────────────────────────────────
# ecosystem.config.cjs forces HOST=127.0.0.1 and PORT=4003 on the VPS;
# these are useful for local preview or overriding PM2 env.
HOST=127.0.0.1
PORT=4003
NODE_ENV=production

# ── ABA PayWay sandbox (KHQR) ────────────────────────────────────────────────
# Copy to `.env` on the server (never commit real secrets):
#   cp .env.example .env && nano .env
#
# Sandbox portal: https://checkout-sandbox.payway.com.kh
# Required for live KHQR generate + status poll. If any of MERCHANT_ID / API_KEY /
# BASE_URL is empty, checkout falls back to demo confirm (no ABA QR).

PAYWAY_MERCHANT_ID=your_sandbox_merchant_id
PAYWAY_API_KEY=your_sandbox_api_key
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh

# Optional — only if your ABA account docs require RSA for other APIs.
# Current POS KHQR path uses HMAC-SHA512 with PAYWAY_API_KEY (not these RSA fields).
PAYWAY_RSA_PUBLIC_KEY=
PAYWAY_RSA_PRIVATE_KEY=
